# InfraBeat repo line-ending policy
# Default: auto-detect text vs binary, normalize to LF in repo
* text=auto eol=lf

# Unix-targeted files: ALWAYS LF (these run on the VMs)
*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# Windows-targeted files: CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Binary (do not touch)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.gz        binary
*.tar       binary
*.zip       binary
*.db        binary
*.sqlite    binary