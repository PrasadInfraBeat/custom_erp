{
  "permissions": {
    "allow": [
      "mcp__frappe-dev__*",
      "mcp__frappe-staging__list_*",
      "mcp__frappe-staging__get_*",
      "mcp__github__list_*",
      "mcp__github__get_*",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)"
    ],
    "ask": [
      "mcp__frappe-staging__create_*",
      "mcp__frappe-staging__update_*",
      "mcp__frappe-staging__delete_*",
      "mcp__github__create_*",
      "mcp__github__merge_*",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "mcp__frappe-production__*",
      "Bash(*push*production*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/audit_pre.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/audit_post.sh" }
        ]
      }
    ]
  }
}