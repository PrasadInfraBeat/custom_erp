const _fetchSummary = (frm) => {
    // Example: call the whitelisted server method get_summary.
    if (!frm.doc.name || frm.is_new()) return;

    frappe.call({
        method: "custom_erp.custom_erp.doctype.{{SNAKE_NAME}}.{{SNAKE_NAME}}.get_summary",
        args: { name: frm.doc.name },
        callback: (r) => {
            if (r.message) {
                console.log("Summary:", r.message);
            }
        }
    });
};