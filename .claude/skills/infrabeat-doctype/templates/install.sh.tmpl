#!/bin/bash
# {{DOCTYPE_NAME}} install commands.
# Generated by infrabeat-doctype skill on {{TIMESTAMP}}.
#
# WHERE: SSH on dev VM (10.1.0.184) as erpadmin, then sudo su - frappe
# WHAT:  Pull latest code, ensure __init__.py exists at every level,
#        run migrate + clear-cache + clear-website-cache + build, restart workers.
# WHEN:  After the doctype JSON/PY/JS files are merged to dev branch and pulled
#        on the VM. infrabeat-deploy automates this; manual run is fallback.

set -euo pipefail

BENCH=/home/frappe/frappe-bench
SITE=erp.local
APP=custom_erp
DOCTYPE_FOLDER=apps/${APP}/${APP}/${APP}/doctype/{{SNAKE_NAME}}

cd "${BENCH}"

# Sanity: confirm we are on dev branch in the app
cd "apps/${APP}"
echo "App branch: $(git branch --show-current)"
echo "App HEAD:   $(git rev-parse --short HEAD)"
cd "${BENCH}"

# Ensure every Python folder along the doctype path has __init__.py.
# Missing one of these causes Frappe v15 to silently 404 the DocType (gotcha #2).
touch "${DOCTYPE_FOLDER}/__init__.py"
test -f "apps/${APP}/${APP}/${APP}/__init__.py" || touch "apps/${APP}/${APP}/${APP}/__init__.py"
test -f "apps/${APP}/${APP}/${APP}/doctype/__init__.py" || touch "apps/${APP}/${APP}/${APP}/doctype/__init__.py"

# Apply schema changes
bench --site "${SITE}" migrate

# Clear caches (paired with migrate per gotcha #6)
bench --site "${SITE}" clear-cache
bench --site "${SITE}" clear-website-cache

# Rebuild assets so any new JS picks up
bench build --app "${APP}"

# Restart workers so the new controller is loaded
bench restart || sudo supervisorctl restart all

echo "OK: {{DOCTYPE_NAME}} installed on ${SITE}."
echo "Verify at: http://10.1.0.184/app/{{SNAKE_NAME}}"